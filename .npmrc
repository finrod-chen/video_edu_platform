# next-auth@5.0.0-beta.32 declares an optional peer dependency on
# nodemailer@^7.0.7 || ^8.0.5 (its email sign-in provider, which this app
# doesn't use -- auth is Google SSO only). We run nodemailer@9.x for the
# Gmail SMTP assignment-notification feature, which fixes a high-severity
# advisory that has no fix released in the 8.x line. That version mismatch
# makes plain `npm ci`/`npm install` hard-fail with ERESOLVE even though the
# peer is optional and unused -- legacy-peer-deps skips that strict check.
legacy-peer-deps=true
