# Copy this file to .env.local for local dev, or set these as real
# environment variables on the Docker host / container for production.
# Never commit actual credentials — .env, .env.local, .env*.local are
# already gitignored.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=
DB_NAME=tebiki_clone
DB_CONNECTION_LIMIT=10

# Next.js server port/host (used by .next/standalone/server.js)
PORT=3000
HOSTNAME=0.0.0.0

# --- Google SSO (Auth.js / next-auth) ---
# Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud
# Console for the xiyuebiomed.com.tw Workspace, with an authorized redirect
# URI of https://<your-domain>/api/auth/callback/google (and
# http://localhost:3000/api/auth/callback/google for local dev).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random 32+ byte secret used to sign/encrypt session JWTs. Generate one with:
#   openssl rand -base64 33
AUTH_SECRET=

# Required when running behind a reverse proxy / in Docker so Auth.js trusts
# the forwarded Host header instead of rejecting the callback URL.
AUTH_TRUST_HOST=true

# The canonical public URL of this deployment (no trailing slash). Without
# this, Auth.js tries to infer the origin from request headers, which can
# resolve to the container's own bind address (e.g. http://0.0.0.0:3000)
# behind some reverse proxies / tunnels (e.g. Cloudflare Tunnel) instead of
# the real public domain -- causing broken redirect_uri / callback URLs.
# Set this explicitly for any non-localhost deployment.
AUTH_URL=https://video-edu.xiyuebiomed.com.tw

# --- Manual video storage ---
# Where uploaded manual videos/thumbnails are written. Relative paths
# resolve from the project root in both `next dev` and the Docker
# container (WORKDIR /app), so the default works in both without change.
# In Docker this directory should be a mounted volume (see
# docker-compose.prod.yml) so uploads survive container recreation.
UPLOAD_DIR=./uploads

# --- Gmail SMTP (assignment notifications) ---
# Use a Google Account App Password (not your normal login password) --
# requires 2-Step Verification enabled on the sending Gmail account:
# https://myaccount.google.com/apppasswords
# Sending is best-effort: if these are unset or sending fails, assignment
# creation still succeeds (the email is just skipped/logged as failed).
GMAIL_SMTP_USER=
GMAIL_SMTP_PASSWORD=
GMAIL_SMTP_FROM=

# --- OpenAI Whisper (manual "產生字幕" button / batch caption backfill) ---
# Optional: without this, the caption buttons in the manual editor will
# fail when clicked, but nothing else in the app is affected.
OPENAI_API_KEY=
