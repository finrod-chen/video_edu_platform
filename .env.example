# Copy this file to .env.local for local dev, or set these as real
# environment variables on the Docker host / container for production.
# Never commit actual credentials — .env, .env.local, .env*.local are
# already gitignored.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=
DB_NAME=tebiki_clone
DB_CONNECTION_LIMIT=10

# Next.js server port/host (used by .next/standalone/server.js)
PORT=3000
HOSTNAME=0.0.0.0

# --- Google SSO (Auth.js / next-auth) ---
# Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud
# Console for the xiyuebiomed.com.tw Workspace, with an authorized redirect
# URI of https://<your-domain>/api/auth/callback/google (and
# http://localhost:3000/api/auth/callback/google for local dev).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random 32+ byte secret used to sign/encrypt session JWTs. Generate one with:
#   openssl rand -base64 33
AUTH_SECRET=

# Required when running behind a reverse proxy / in Docker so Auth.js trusts
# the forwarded Host header instead of rejecting the callback URL.
AUTH_TRUST_HOST=true
